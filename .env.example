NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/fintrack
# Canonical JWT settings. The *_ACCESS_* names below remain supported aliases.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
# Backward-compatible aliases:
JWT_ACCESS_SECRET=replace-with-a-long-random-secrhh-another-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
API_BASE_URL=http://localhost:3000/api
REDIS_URL=redis://127.0.0.1:6379
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=
FRONTEND_URL=http://localhost:5500
CORS_ORIGIN=http://localhost:5500
# Upstox OAuth credentials belong only in the backend .env (never VITE_*).
# Register this exact redirect URI in the Upstox developer app. For production,
# set it to your deployed website's /settings URL.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5173/settings
# Do not commit the supplied operator secret. An opaque key alone cannot
# reliably identify Alpaca, Finnhub, or Alpha Vantage; confirm its issuer
# before selecting MARKET_DATA_PROVIDER and place it in that provider's
# variable below.
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
CRYPTO_COMPARE_API_KEY=
MARKET_DATA_FALLBACK_URL=https://query1.finance.yahoo.com
# Optional financial news feed token; keep server-side and never prefix with VITE_.
MARKETAUX_API_TOKEN=
LOG_LEVEL=info
# Gemini API key from Google AI Studio. Keep the real value in .env only.
GEMINI_API_KEY=replace-with-your-rotated-google-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash
